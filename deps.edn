{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:server {:extra-deps {ring/ring-jetty-adapter {:mvn/version "1.15.3"}}}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      ring/ring-jetty-adapter {:mvn/version "1.15.3"}
                      org.xerial/sqlite-jdbc {:mvn/version "3.46.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner" "-d" "test"]}
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.23"}}}
  :hello {:extra-paths ["examples/hello/src" "examples/hello/resources"]}}}
